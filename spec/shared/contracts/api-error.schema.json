{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiError",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryAfter": {
          "type": "number"
        }
      },
      "required": [
        "reason",
        "message"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": true
}
