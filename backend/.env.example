# ⚠ 이 repo 는 public 이다. 실제 키를 여기에도, 코드·문서 본문에도 붙여넣지 않는다.
#   실수했으면 지우는 게 아니라 폐기(rotate) 한다.
# 실제 값은 .env 에 넣는다 (.gitignore 처리됨 — 커밋 금지)

# ── 앱 ─────────────────────────────
APP_ENV=local                 # local | dev | prod
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false

# ── DB / Redis ────────────────────
DATABASE_URL=postgresql+asyncpg://devon:devon@localhost:5432/devon
REDIS_URL=redis://localhost:6379/0

# ── 쿠키 / 세션 ───────────────────
SESSION_COOKIE_NAME=devon_session
SESSION_TTL_SECONDS=1209600
COOKIE_SECURE=false           # prod=true
COOKIE_SAMESITE=lax           # prod도 lax (ADR 0003)

# ── GitHub OAuth ──────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_LOGIN_SCOPE=read:user
GITHUB_LINK_SCOPE=read:user    # public 저장소 읽기에 repo/public_repo scope 불필요
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback
# 로그인과 재연동 모두 위 공개 주소 하나를 GitHub OAuth App에 등록해 사용한다.
# Vite/Caddy가 공개 /auth/github/*를 내부 /api/auth/github/*로 전달한다.
# Sprint 1 장기 토큰 전제: Expire user access tokens OFF, offline_access 요청 없음.

# GitHub 토큰 암호화 (access_token_encrypted는 BYTEA, Sprint 1에는 갱신 토큰 컬럼 없음)
# AES-GCM 256bit 키를 base64 로. 평문 토큰 저장은 금지.
# refresh token 은 받지도 저장하지도 않는다 (long-lived OAuth App access token 전제).
TOKEN_ENCRYPTION_KEY=

# ── LLM (Sprint 1: OpenAI, ADR 0011) ─────────
OPENAI_API_KEY=
# Responses 호환 프록시를 쓸 때는 아래 두 값을 함께 입력한다. 둘 다 있으면 직접 연결보다 우선한다.
# CHAT_PROXY_URL은 /responses를 제외한 HTTPS 기본 주소이며 tenant/v1 같은 앞 경로를 보존한다.
PROXY_TOKEN=
CHAT_PROXY_URL=
# 명시하면 LLM_DEFAULT_MODEL보다 우선하는 등록·점검 기본 모델이다. 기존 DB 모델은 바꾸지 않는다.
# 명시한 OPENAI_MODEL이 아래 LLM_DEFAULT_MODEL보다 우선한다.
OPENAI_MODEL=
# 같은 PROXY_TOKEN을 사용하는 연결 중 주소·모델을 쌍으로 선택한다. 1은 기존 기본 연결이다.
# 실제 비공개 주소와 키는 로컬 환경에만 설정한다.
LLM_CONNECTION_SLOT=1
# 실제 공개 레포 L1이 50초를 넘긴 사례를 반영한다. 다른 작업의 기본 50초는 유지한다.
# L2는 실제 120초 timeout과 별도 지연 변동을 반영해 준비 worker 예산 안에서 여유를 둔다.
LLM_TASK_TIMEOUTS={}
CHAT_PROXY_URL_2=
OPENAI_MODEL_2=
CHAT_PROXY_URL_3=
OPENAI_MODEL_3=
# ⚠ 모델 ID 를 코드 상수로 두지 않는다. prompt_versions.model / repo_analyses.model /
#   interview_sessions.model 이 "어느 모델로 만든 결과인지" 를 결정한다.
#   아래 값은 로컬 설정 예시이며, 실제 사용 모델은 DB 에 저장한다.
LLM_DEFAULT_MODEL=gpt-5.6-luna
# 사용자 지정 로컬 값이다. 작업별 지연·응답량·동시 실행 메모리를 측정해 운영 환경에서 조정한다.
# timeout은 provider 시도 1회 기준 초, input/response는 UTF-8 HTTP 본문 byte 상한이다.
LLM_TIMEOUT_SECONDS=
LLM_MAX_OUTPUT_TOKENS=
LLM_MAX_INPUT_BYTES=
LLM_MAX_RESPONSE_BYTES=
LLM_MAX_RETRIES=1             # 고정: 공통 호출 총 2회. semantic 실패는 재호출 금지
# 공급자가 지원할 때만 명시한다. 비어 있으면 요청 필드 자체를 생략한다.
LLM_REASONING_EFFORT=
# Elice 현재 proxy는 비스트리밍 2000 token 상한이 있다. 긴 리포트는 true와 충분한 출력 예산을 쓴다.
# 전체 SSE를 수신·검증한 뒤 결과 하나만 반환하며 FE 이벤트 계약은 바꾸지 않는다.
LLM_STREAM=false
# 로컬 호출·단계 장부를 사용할 때만 지정한다. 실제 .env의 모델·추론·상한은 유지한다.
# AI_EXECUTION_LEDGER_PATH=report/ai-execution.sqlite3
# core/config.py의 get_settings()가 환경을 읽고 require_llm()/call_limits()가 호출 준비를 검증한다.
# 실제 계정 접근·운영 prompt 품질·운영 한도는 별도 확인해야 한다.
# 점검·새 프롬프트 버전 등록은 docs/llm-connection.md를 따른다.

# ── 선택 음성 출력 (Google Cloud Chirp 3 HD) ──────────────
# 저장된 answerMode는 유지한다. 미설정·예산 소진 시 질문 텍스트를 사용한다.
# 선택한 공급자와 음성이다. 실제 키·프로젝트·확인한 잔여 예산이 없으면 합성을 차단한다.
TTS_PROVIDER=
TTS_API_KEY=
TTS_ACCESS_TOKEN=
TTS_LANGUAGE_CODE=ko-KR
# 청취한 세 음성을 페르소나마다 다르게 배정한다. 키·프로젝트는 예제에 넣지 않는다.
TTS_VOICE_MAP={}
# 앱의 월 사용 상한이다. 실제 Cloud 잔여량은 예산 초기화 때 별도로 확인한다.
TTS_MONTHLY_CHARACTER_LIMIT=
TTS_BUDGET_PROJECT=
# Cloud 조회 또는 확인된 전체 이력으로 잔여량과 진행 중 호출을 확인한다(ADR 0037).
# initialize_tts_budget CLI의 Cloud 확인 플래그는 실제 조회한 경우에만 사용한다.
# Redis 유실·월 변경은 자동으로 무료 한도를 복구하지 않는다.

# ── 공식 출처 검색·본문 추출 (Tavily) ──────────────
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=20
TAVILY_MAX_RESULTS=5
TAVILY_MAX_CALLS=4
TAVILY_MAX_CREDITS=4
EXTERNAL_MAX_CALLS_PER_INTERVIEW=8
EXTERNAL_MAX_CREDITS_PER_INTERVIEW=8
EXTERNAL_SOURCES_CACHE_SECONDS=3600

# ── 선택 OCR/VLM (Elice Helpy Document Vision) ──────────────
# 모델 서비스 기본 HTTPS 주소. /v1/documents는 어댑터가 붙인다.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=eliceai/helpy-document-vision
VISION_TIMEOUT_SECONDS=60
# 이미지 다운로드별30초와 별개로, 기본4장×(다운로드30초+Vision60초)의 전체 한도다.
JD_IMAGE_TIMEOUT_SECONDS=30
JD_IMAGE_TOTAL_TIMEOUT_SECONDS=360
VISION_MAX_POLLS=12
VISION_POLL_INTERVAL_SECONDS=1
VISION_JOB_PATH_TEMPLATE=/v1/jobs/{job_id}
# native PDF 제목이 있어도 표/도식 영역을 보완한다. 공급자가 설정된 경우에만 호출한다.
VISION_PDF_LAYOUT=false
DOCUMENTS_MAX_SOURCE_CHARS=262144

# ── STT (MLAPI Whisper) ───────────
# 비어 있어도 앱은 기동하며 답변 전사 호출 전 검증이 실패한다. 값은 .env 에만 넣는다.
# STT_BASE_URL 은 HTTPS 기본 주소다 (/v1/audio/transcriptions 는 코드가 붙인다).
STT_PROVIDER=
STT_BASE_URL=
STT_API_KEY=
# 아래는 코드 기본값(whisper-large-v3 / korean / 30초 / 10MiB)을 바꿀 때만 주석을 푼다.
# MLAPI 는 언어 코드(ko)가 아니라 이름(korean)을 받는다.
# STT_MODEL=
# STT_LANGUAGE=
# STT_TIMEOUT_SECONDS=
# STT_MAX_RESPONSE_BYTES=
# STT_MAX_AUDIO_BYTES=
# STT_MIN_AUDIO_BYTES=
# 무음 환각 필터: 쉼표로 구분한 문구와 길이 상한(초). 빈 값이면 필터를 끈다.
# STT_HALLUCINATION_PHRASES=
# STT_HALLUCINATION_MAX_SECONDS=
# ANSWER_AUDIO_MAX_SECONDS=
# ANSWER_AUDIO_GRACE_SECONDS=
# ANSWER_AUDIO_IDLE_TIMEOUT_SECONDS=

# 아래 원문 byte 상한은 면접 진행 중 근거 조회 전용이다.
DIRECTOR_EVIDENCE_MAX_RESPONSE_BYTES=131072
DIRECTOR_EVIDENCE_MAX_TOTAL_BYTES=262144
# 준비 단계의 구조 목록은 면접 중 보완 조회와 별도 예산을 쓴다.
# 구조가 커져도 모델에 전달하는 원문 상한과 파일별 구간 상한은 유지한다.
DIRECTOR_PREPARE_MAX_RESPONSE_BYTES=2097152
DIRECTOR_PREPARE_MAX_TOTAL_BYTES=8388608
DIRECTOR_PREPARE_MAX_SOURCE_BYTES=262144
DIRECTOR_PREPARE_MAX_ENTRIES=8192
DIRECTOR_PREPARE_MAX_DEPTH=12
DIRECTOR_PREPARE_MAX_REQUESTS=32
DIRECTOR_PREPARE_MAX_FILES=8
DIRECTOR_PREPARE_MAX_FILE_BYTES=32768
# 선택한 공급자의 schema 예산이다. 요청 byte 상한과 함께 적용하고 필요하면 낮춘다.
REPOSITORY_SELECTION_MAX_ENUM_VALUES=900
REPOSITORY_SELECTION_MAX_ENUM_CHARACTERS=14000
DIRECTOR_PREPARE_TIMEOUT_SECONDS=30

# ── 정책 · 분석 ───────────────────
ANALYSIS_RUN_TTL_SECONDS=7200        # run_expired
MAX_UPLOAD_BYTES_COVER_LETTER=10485760   # 자소서 10MB
MAX_UPLOAD_BYTES_PORTFOLIO=20971520      # 포폴 20MB
DOCUMENTS_MAX_TEXT_CHARS=50000          # 보관 텍스트 글자 수, 축약 전 GitHub URL은 별도 보존
REPO_CANDIDATE_LIMIT=10              # 룰 필터 통과 상한 (포폴 언급 레포는 이 제한을 우회)
REPO_MIN_SIZE_KB=50                  # 룰 필터 임계값 — 실측 후 조정
JD_REUSE_TTL_DAYS=7                  # fetched_at 이 이내면 공고 행 재사용, LLM 0회
JD_REQUIREMENT_LIMIT=20
CLAIM_LIMIT=10                       # 자소서 주장 상한

# ── 정책 · 면접 ───────────────────
# 진행 중 근거 조회의 유한 초기 상한. 실제 품질·지연 평가는 별도다.
DIRECTOR_EVIDENCE_MAX_REQUESTS=12
DIRECTOR_EVIDENCE_MAX_FILES=2
DIRECTOR_EVIDENCE_TIMEOUT_SECONDS=8

MAX_ACTIVE_INTERVIEWS_PER_USER=1     # session_limit_exceeded
MAX_SELECTED_REPOS=5                 # is_selected 상한
MAX_AI_RECOMMENDED=5                 # ★ is_selected 상한과 같아야 한다.
                                     #   8개를 추천하면 채택률이 구조적으로 62.5% 를 못 넘어
                                     #   지표가 처음부터 망가진 채 쌓인다.
INTERVIEW_MAX_TURNS=9                # 고정: 정상 면접은 9턴, 첫 질문은 HR
INTERVIEW_DURATION_SECONDS=1200      # 9턴 × 텍스트 2분 ≈ 20분
# 고정 배정은 tech_lead:6,domain_lead:2,hr_manager:1이며 다른 배정값은 기동 시 거부한다.
# PERSONA_TURN_QUOTA=tech_lead:6,domain_lead:2,hr_manager:1
# 정책 원본: 공통 ADR 0008 (spec/shared/decisions/0008-fixed-persona-allocation.md).
