diff --git a/backend/tests/features/interview/test_question_retry_router.py b/backend/tests/features/interview/test_question_retry_router.py
new file mode 100644
--- /dev/null
+++ b/backend/tests/features/interview/test_question_retry_router.py
@@ -0,0 +1,99 @@
+"""실제 HTTP 인증·입력·응답 계약과 검증된 복구 서비스의 연결 경계."""
+
+from uuid import uuid4
+
+import pytest
+
+from app.core.errors import AppError
+from app.features.interview import question_retry
+from app.features.interview.schemas import QuestionRetryResponse
+from app.shared.enums import Reason
+
+from .factories import make_user
+
+
+@pytest.fixture
+async def owner(app, db, client, monkeypatch):
+    user = await make_user(db)
+    await db.commit()
+    client.cookies.set("devon_session", await app.state.sessions.create(user.id))
+    settings = object()
+    monkeypatch.setattr(type(app.state.settings), "require_llm", lambda _self: settings)
+    return user.id, settings
+
+
+async def test_retry_http_requires_authentication(client, monkeypatch):
+    async def unexpected(*args, **kwargs):
+        pytest.fail("인증되지 않은 요청은 복구를 실행하면 안 된다")
+
+    monkeypatch.setattr(question_retry, "retry_question", unexpected)
+    response = await client.post(
+        f"/api/interviews/{uuid4()}/question/retry", json={"requestId": str(uuid4())}
+    )
+    assert response.status_code == 401
+    assert response.json()["error"]["reason"] == "unauthenticated"
+
+
+async def test_retry_http_passes_owner_and_request_identity(app, client, owner, monkeypatch):
+    user_id, settings = owner
+    interview_id, request_id = uuid4(), uuid4()
+
+    async def execute(sessions, redis, **kwargs):
+        assert sessions is app.state.session_factory
+        assert redis is app.state.redis
+        assert kwargs["user_id"] == user_id
+        assert kwargs["interview_id"] == interview_id
+        assert kwargs["request_id"] == request_id
+        assert kwargs["settings"] is settings
+        return QuestionRetryResponse(
+            interview_id=interview_id, session_id="fresh-session", turn_no=5
+        )
+
+    monkeypatch.setattr(question_retry, "retry_question", execute)
+    response = await client.post(
+        f"/api/interviews/{interview_id}/question/retry", json={"requestId": str(request_id)}
+    )
+    assert response.status_code == 200
+    assert response.json() == {
+        "interviewId": str(interview_id),
+        "sessionId": "fresh-session",
+        "turnNo": 5,
+    }
+
+
+async def test_retry_http_invalid_identity_never_executes(client, owner, monkeypatch):
+    async def unexpected(*args, **kwargs):
+        pytest.fail("잘못된 요청 ID로 모델을 실행하면 안 된다")
+
+    monkeypatch.setattr(question_retry, "retry_question", unexpected)
+    response = await client.post(
+        f"/api/interviews/{uuid4()}/question/retry", json={"requestId": "invalid"}
+    )
+    assert response.status_code == 400
+    assert response.json()["error"]["reason"] == "invalid_request"
+
+
+async def test_retry_http_rejection_uses_shared_envelope(client, owner, monkeypatch):
+    async def rejected(*args, **kwargs):
+        raise AppError(Reason.QUESTION_RETRY_FAILED)
+
+    monkeypatch.setattr(question_retry, "retry_question", rejected)
+    response = await client.post(
+        f"/api/interviews/{uuid4()}/question/retry", json={"requestId": str(uuid4())}
+    )
+    assert response.status_code == 409
+    assert response.json()["error"]["reason"] == "question_retry_failed"
+
+
+async def test_retry_http_foreign_origin_never_executes(client, owner, monkeypatch):
+    async def unexpected(*args, **kwargs):
+        pytest.fail("다른 Origin의 상태 변경 요청은 실행하면 안 된다")
+
+    monkeypatch.setattr(question_retry, "retry_question", unexpected)
+    response = await client.post(
+        f"/api/interviews/{uuid4()}/question/retry",
+        json={"requestId": str(uuid4())},
+        headers={"Origin": "https://foreign.invalid"},
+    )
+    assert response.status_code == 403
+    assert response.json()["error"]["reason"] == "unauthenticated"
