diff --git a/backend/.env.example b/backend/.env.example
--- a/backend/.env.example
+++ b/backend/.env.example
@@ -46,6 +46,8 @@
 # 같은 PROXY_TOKEN을 사용하는 연결 중 주소·모델을 쌍으로 선택한다. 1은 기존 기본 연결이다.
 # 실제 비공개 주소와 키는 로컬 환경에만 설정한다.
 LLM_CONNECTION_SLOT=1
+# 실제 공개 레포 L1이 50초를 넘긴 사례를 반영한다. 다른 작업의 기본 50초는 유지한다.
+# L2는 실제 120초 timeout과 별도 지연 변동을 반영해 준비 worker 예산 안에서 여유를 둔다.
 LLM_TASK_TIMEOUTS={}
 CHAT_PROXY_URL_2=
 OPENAI_MODEL_2=
@@ -55,7 +57,7 @@
 #   interview_sessions.model 이 "어느 모델로 만든 결과인지" 를 결정한다.
 #   아래 값은 로컬 설정 예시이며, 실제 사용 모델은 DB 에 저장한다.
 LLM_DEFAULT_MODEL=gpt-5.6-luna
-# 선택 항목은 config/ai-development.env.example에서 확인하고 값은 로컬 .env에 지정한다.
+# 사용자 지정 로컬 값이다. 작업별 지연·응답량·동시 실행 메모리를 측정해 운영 환경에서 조정한다.
 # timeout은 provider 시도 1회 기준 초, input/response는 UTF-8 HTTP 본문 byte 상한이다.
 LLM_TIMEOUT_SECONDS=
 LLM_MAX_OUTPUT_TOKENS=
@@ -130,11 +132,16 @@
 # ANSWER_AUDIO_GRACE_SECONDS=
 # ANSWER_AUDIO_IDLE_TIMEOUT_SECONDS=
 
-# 원문 byte 상한은 준비·진행 중 근거 조회에서 공유한다. PREPARE 상한은 준비 전용이다.
+# 아래 원문 byte 상한은 면접 진행 중 근거 조회 전용이다.
 DIRECTOR_EVIDENCE_MAX_RESPONSE_BYTES=131072
 DIRECTOR_EVIDENCE_MAX_TOTAL_BYTES=262144
-DIRECTOR_PREPARE_MAX_ENTRIES=512
-DIRECTOR_PREPARE_MAX_DEPTH=8
+# 준비 단계의 구조 목록은 면접 중 보완 조회와 별도 예산을 쓴다.
+# 구조가 커져도 모델에 전달하는 원문 상한과 파일별 구간 상한은 유지한다.
+DIRECTOR_PREPARE_MAX_RESPONSE_BYTES=2097152
+DIRECTOR_PREPARE_MAX_TOTAL_BYTES=8388608
+DIRECTOR_PREPARE_MAX_SOURCE_BYTES=262144
+DIRECTOR_PREPARE_MAX_ENTRIES=8192
+DIRECTOR_PREPARE_MAX_DEPTH=12
 DIRECTOR_PREPARE_MAX_REQUESTS=32
 DIRECTOR_PREPARE_MAX_FILES=8
 DIRECTOR_PREPARE_MAX_FILE_BYTES=32768
