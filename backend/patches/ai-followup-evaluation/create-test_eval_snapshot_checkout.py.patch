diff --git a/ai/tests/test_eval_snapshot_checkout.py b/ai/tests/test_eval_snapshot_checkout.py
new file mode 100644
--- /dev/null
+++ b/ai/tests/test_eval_snapshot_checkout.py
@@ -0,0 +1,69 @@
+"""과거 출처의 raw 지문을 실제 Git 저장·체크아웃에서도 보존한다."""
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+from source_snapshot import SNAPSHOT_DIRECTORY, validate_bound_sources
+
+EVALS = Path(__file__).parents[1] / "evals"
+COHORTS = ("service_regression", "report_source_binding_cohort", "component_regression")
+
+
+@pytest.mark.parametrize("checkout_autocrlf", ["false", "true"])
+def test_historical_raw_sources_survive_git_checkout(tmp_path, checkout_autocrlf):
+    # 별도 저장소에서만 커밋한다. 호스트의 Git 설정·훅·실제 index는 사용하지 않는다.
+    repo, checkout = tmp_path / "repo", tmp_path / "checkout"
+    repo.mkdir()
+    isolated = tmp_path / "empty-config"
+    isolated.write_text("", encoding="utf-8")
+    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
+    env.update(GIT_CONFIG_GLOBAL=str(isolated), GIT_CONFIG_NOSYSTEM="1", GIT_ATTR_NOSYSTEM="1")
+
+    def git(*args, cwd=repo):
+        return subprocess.run(
+            ["git", "-c", f"core.attributesFile={isolated}", *args],
+            cwd=cwd,
+            env=env,
+            check=True,
+            capture_output=True,
+        ).stdout
+
+    destination = repo / "ai/evals"
+    shutil.copytree(EVALS / SNAPSHOT_DIRECTORY, destination / SNAPSHOT_DIRECTORY)
+    for cohort in COHORTS:
+        shutil.copytree(EVALS / cohort, destination / cohort)
+    # 범위 밖의 일반 텍스트는 Git의 줄바꿈 변환이 실제 작동하는지 확인한다.
+    (repo / "ordinary.txt").write_bytes(b"ordinary\r\n")
+    git("init", "--quiet")
+    git("config", "core.autocrlf", "true")
+    git("config", "core.hooksPath", str(tmp_path / "no-hooks"))
+    git("config", "user.name", "snapshot-test")
+    git("config", "user.email", "snapshot-test@example.invalid")
+    git("-c", "commit.gpgsign=false", "add", ".")
+    git("-c", "commit.gpgsign=false", "commit", "--quiet", "-m", "snapshot fixture")
+    assert git("show", "HEAD:ordinary.txt") == b"ordinary\n"
+    marker = json.loads((EVALS / SNAPSHOT_DIRECTORY / "provenance.json").read_text("utf-8"))
+    assert len(marker["files"]) == 59
+    for relative, expected in marker["files"].items():
+        content = git("show", f"HEAD:ai/evals/{SNAPSHOT_DIRECTORY}/{relative}")
+        assert hashlib.sha256(content).hexdigest() == expected, relative
+    marker_bytes = (EVALS / SNAPSHOT_DIRECTORY / "provenance.json").read_bytes()
+    assert git("show", f"HEAD:ai/evals/{SNAPSHOT_DIRECTORY}/provenance.json") == marker_bytes
+
+    git("clone", "--quiet", "--local", "--no-hardlinks", "--no-checkout", str(repo), str(checkout))
+    git("config", "core.autocrlf", checkout_autocrlf, cwd=checkout)
+    git("config", "core.hooksPath", str(tmp_path / "no-hooks"), cwd=checkout)
+    git("checkout", "--quiet", "--force", "HEAD", cwd=checkout)
+    for relative, expected in marker["files"].items():
+        content = (checkout / "ai/evals" / SNAPSHOT_DIRECTORY / relative).read_bytes()
+        assert hashlib.sha256(content).hexdigest() == expected, relative
+    assert (checkout / "ai/evals" / SNAPSHOT_DIRECTORY / "provenance.json").read_bytes() == (
+        marker_bytes
+    )
+    for cohort in COHORTS:
+        validate_bound_sources(checkout / "ai/evals" / cohort)
