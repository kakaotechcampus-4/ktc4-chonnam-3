# 선택한 개발 연결의 예산 예시. 운영 기본값이나 공급자 한도를 보장하지 않는다.
# .env.example을 복사한 뒤 필요한 항목만 로컬 .env에 적용한다. 키와 주소는 넣지 않는다.
OPENAI_MODEL=gpt-6-luna
LLM_TASK_TIMEOUTS={"repo_shallow":180.0,"repo_deep":160.0,"answer_analysis":120.0,"director":120.0,"report_score":180,"report":180}
OPENAI_MODEL_2=gpt-6.1-terra
OPENAI_MODEL_3=gpt-6.1-sol
LLM_TIMEOUT_SECONDS=50
LLM_MAX_OUTPUT_TOKENS=128000
LLM_MAX_INPUT_BYTES=262144
LLM_MAX_RESPONSE_BYTES=67108864
LLM_REASONING_EFFORT=xhigh
LLM_STREAM=true
TTS_PROVIDER=google_cloud
TTS_VOICE_MAP={"tech_lead":"ko-KR-Chirp3-HD-Charon","domain_lead":"ko-KR-Chirp3-HD-Kore","hr_manager":"ko-KR-Chirp3-HD-Aoede"}
TTS_MONTHLY_CHARACTER_LIMIT=1000000
