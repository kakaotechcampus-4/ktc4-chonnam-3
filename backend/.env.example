# ⚠ 이 repo 는 public 이다. 실제 키를 여기에도, 코드·문서 본문에도 붙여넣지 않는다.
#   실수했으면 지우는 게 아니라 폐기(rotate) 한다.
# 실제 값은 .env 에 넣는다 (.gitignore 처리됨 — 커밋 금지)

# ── 앱 ─────────────────────────────
APP_ENV=local                 # local | dev | prod
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# ── DB / Redis ────────────────────
DATABASE_URL=postgresql+asyncpg://devon:devon@localhost:5432/devon
REDIS_URL=redis://localhost:6379/0

# ── 쿠키 / 세션 ───────────────────
SESSION_COOKIE_NAME=devon_session
SESSION_TTL_SECONDS=1209600
COOKIE_SECURE=false           # prod=true
COOKIE_SAMESITE=lax           # prod도 lax (ADR 0003)

# ── DEVON 자체 JWT ────────────────
# HttpOnly accessToken 쿠키로 전달한다. WS handshake 도 같은 쿠키를 쓴다.
# ⚠ payload 에 GitHub access token 을 넣지 않는다 — users.id 같은 식별자만 담는다.
AUTH_COOKIE_NAME=accessToken
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=1209600

# ── GitHub OAuth ──────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_LOGIN_SCOPE=read:user
GITHUB_LINK_SCOPE=read:user    # public 저장소 읽기에 repo/public_repo scope 불필요
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# GitHub 토큰 암호화 (access_token_encrypted는 BYTEA, Sprint 1에는 갱신 토큰 컬럼 없음)
# AES-GCM 256bit 키를 base64 로. 평문 토큰 저장은 금지.
# refresh token 은 받지도 저장하지도 않는다 (long-lived OAuth App access token 전제).
TOKEN_ENCRYPTION_KEY=

# ── LLM (Sprint 1: OpenAI, ADR 0011) ─────────
OPENAI_API_KEY=
# ⚠ 모델 ID 를 코드 상수로 두지 않는다. prompt_versions.model / repo_analyses.model /
#   interview_sessions.model 이 "어느 모델로 만든 결과인지" 를 결정한다.
#   아래 값은 seed·설정이 읽는 스프린트1 기본값일 뿐이고, 실제 사용값은 DB 에 저장한다.
LLM_DEFAULT_MODEL=gpt-5.6-luna
# 네 제한값은 운영 예산에 맞게 명시한다. 비어 있어도 앱은 기동하며 LLM 호출 전 검증은 실패한다.
# timeout은 provider 시도 1회 기준 초, input/response는 UTF-8 HTTP 본문 byte 상한이다.
LLM_TIMEOUT_SECONDS=
LLM_MAX_OUTPUT_TOKENS=
LLM_MAX_INPUT_BYTES=
LLM_MAX_RESPONSE_BYTES=
LLM_MAX_RETRIES=1             # 고정: 공통 호출 총 2회. semantic 실패는 재호출 금지
# core/config.py의 get_settings()가 환경을 읽고 require_llm()/call_limits()가 호출 준비를 검증한다.
# 실제 계정 접근·운영 prompt 품질·운영 한도는 별도 확인해야 한다.

# ── 음성 (스프린트2) ──────────────
# 스프린트1 은 양방향 텍스트다 (interview_sessions.answer_mode = 'text' 고정).
# STT_PROVIDER=
# TTS_PROVIDER=

# ── 정책 · 분석 ───────────────────
ANALYSIS_RUN_TTL_SECONDS=7200        # run_expired
MAX_UPLOAD_BYTES_COVER_LETTER=10485760   # 자소서 10MB
MAX_UPLOAD_BYTES_PORTFOLIO=20971520      # 포폴 20MB
REPO_CANDIDATE_LIMIT=10              # 룰 필터 통과 상한 (포폴 언급 레포는 이 제한을 우회)
REPO_MIN_SIZE_KB=50                  # 룰 필터 임계값 — 실측 후 조정
JD_REUSE_TTL_DAYS=7                  # fetched_at 이 이내면 공고 행 재사용, LLM 0회
JD_REQUIREMENT_LIMIT=20
CLAIM_LIMIT=10                       # 자소서 주장 상한

# ── 정책 · 면접 ───────────────────
MAX_ACTIVE_INTERVIEWS_PER_USER=1     # session_limit_exceeded
MAX_SELECTED_REPOS=5                 # is_selected 상한
MAX_AI_RECOMMENDED=5                 # ★ is_selected 상한과 같아야 한다.
                                     #   8개를 추천하면 채택률이 구조적으로 62.5% 를 못 넘어
                                     #   지표가 처음부터 망가진 채 쌓인다.
INTERVIEW_MAX_TURNS=9                # 정상 면접은 9턴, 첫 질문은 HR
INTERVIEW_DURATION_SECONDS=1200      # 9턴 × 텍스트 2분 ≈ 20분
# 기술 질문은 목표 6턴·최소 5턴, 도메인·HR은 합산 최소 3턴이며 개별 배분은 고정하지 않는다.
# 실제 횟수 제어는 spec/shared/decisions/0004-flexible-persona-allocation-restoration.md에 따라 구현한다.
