             application/json:
               schema:
                 $ref: '#/components/schemas/ApiError'
+  /interviews/{id}/question/retry:
+    post:
+      operationId: retryInterviewQuestion
+      summary: Resume the same interview without resubmitting saved answers
+      description: >-
+        Explicitly regenerates the missing next question after saved answer analysis
+        succeeded and Director generation failed. The server preserves prior turns,
+        analyses, evidence, selected code versions and failed call records. Permanent
+        authentication or quota failures are not eligible. On refresh GET returns
+        questionRetryState so the same requestId can be restored. A replay may rotate
+        realtime session only for the current unanswered target turn. One manual
+        round is allowed per target question; each round has one Plan and one independent
+        Review. A safe rewrite rejection also permits one automatic round. Including
+        initial generation, the target question has at most six provider attempts.
+        Reusing requestId replays its result without another model call. A successful
+        response issues a new realtime sessionId; reconnect to receive the saved next
+        question. STT, answer analysis and repository analysis are not rerun.
+      parameters:
+        - $ref: '#/components/parameters/InterviewId'
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/QuestionRetryRequest'
+      responses:
+        '200':
+          description: The reviewed next question is saved in the same interview.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/QuestionRetryResponse'
+        '400':
+          $ref: '#/components/responses/Error'
+        '401':
+          $ref: '#/components/responses/Error'
+        '404':
+          $ref: '#/components/responses/Error'
+        '409':
+          description: >-
+            question_retry_in_progress while the claimed round is running;
+            question_retry_unavailable outside a recoverable next-question state;
+            question_retry_failed after a completed round is rejected;
+            question_retry_limit after the manual allowance is consumed.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ApiError'
   /interviews/{id}/prepare/retry:
     post:
       operationId: retryInterviewPrepare
@@ -446,6 +494,12 @@
                 $ref: '#/components/schemas/GeneratingResponse'
         '401':
